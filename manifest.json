{
  "manifest_version": 3,
  "name": "Solver Core V2",
  "version": "2.0.0",
  "description": "Archive solver optimized for LMS DUT and Azota",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "https://*.azota.vn/*",
    "https://lms.dut.udn.vn/*",
    "http://lms.dut.udn.vn/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.azota.vn/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*.azota.vn/*"],
      "js": ["stealth.js", "ai_bridge.js", "content_azota.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["https://lms.dut.udn.vn/*", "http://lms.dut.udn.vn/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://lms.dut.udn.vn/*", "http://lms.dut.udn.vn/*"],
      "js": ["stealth.js", "ai_bridge.js", "content_lms.js", "ui_lms.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "stealth.js", "ui_lms.js", "icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}